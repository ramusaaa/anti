{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HADRON Antivirus",
  "version": "1.0.0",
  "identifier": "com.hadron.antivirus",
  "build": {
    "frontendDist": "js",
    "beforeDevCommand": "python3 -m http.server 8080 --directory js",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "windows": [
      {
        "title": "HADRON Antivirus",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
